# =============================================================================
# Dr. XYZ Clinic — Environment Configuration Template
# Copy to `.env` (development) or set these as server environment variables.
# NEVER commit real secrets. All secrets stay server-side.
# =============================================================================

# ---- Application ------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# Server-side session password (any long random string; used by iron-session)
SESSION_PASSWORD=change-me-to-a-long-random-string-min-32-chars

# ---- Admin authentication ---------------------------------------------------
# Admin username for /admin/login
ADMIN_USERNAME=clinicadmin
# Scrypt hash of the admin password. Generate with: node scripts/hash-password.js
ADMIN_PASSWORD_HASH=<scrypt:hex-salt:hash>

# ---- Database ---------------------------------------------------------------
# SQLite file path (kept on server disk; contains patient data — protect it)
DATABASE_PATH=./data/clinic.db

# =============================================================================
# GOOGLE WORKSPACE INTEGRATION (Calendar + Sheets)
# Create a service account in Google Cloud, enable Calendar & Sheets APIs,
# share the "Dr. XYZ — Patient Appointments" calendar and the
# "Dr. XYZ — Clinic Appointment Register" spreadsheet with the service account
# email, then paste the JSON key below (single line) or set the path.
# =============================================================================
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEETS_SPREADSHEET_ID=

# =============================================================================
# NOTIFICATIONS
# Email: any SMTP server (Gmail SMTP, SendGrid, Postmark, etc.)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=clinic@example.com
SMTP_FROM_NAME=Dr. XYZ Clinic
# SMS: Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# =============================================================================
# ONLINE CONSULTATION PLATFORM
# Supported: google_meet | jitsi | zoom | custom
# For zoom, set ZOOM_API_KEY / ZOOM_API_SECRET to auto-create meetings.
# =============================================================================
CONSULTATION_PLATFORM=google_meet
ZOOM_API_KEY=
ZOOM_API_SECRET=
CUSTOM_MEETING_URL_TEMPLATE=

# =============================================================================
# AI RECEPTIONIST / AVATAR PROVIDER
# Options: local (built-in browser demo avatar, no keys) | heygen | did
# When using heygen/did, keep API keys SERVER-SIDE only.
# =============================================================================
AVATAR_PROVIDER=local
HEYGEN_API_KEY=
DID_API_KEY=

# =============================================================================
# FEATURE FLAGS
# Set to true only after verifying production readiness (see docs/LAUNCH.md)
# =============================================================================
ONLINE_CONSULTATIONS_ENABLED=true
SMS_NOTIFICATIONS_ENABLED=false
