# =============================================================================
# Hospital Management System — Environment Configuration Template
# Copy to `.env` (development) or set these as server environment variables.
# NEVER commit real secrets. All secrets stay server-side.
# =============================================================================

# ---- Application ------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# Server-side session password (any long random string; used by iron-session)
SESSION_PASSWORD=change-me-to-a-long-random-string-min-32-chars

# ---- Admin authentication (legacy single-admin) ---------------------------
ADMIN_USERNAME=clinicadmin
# Scrypt hash of the admin password. Generate with: node scripts/hash-password.js
ADMIN_PASSWORD_HASH=<scrypt:hex-salt:hash>

# ---- Super Admin provisioning ---------------------------------------------
# Initial Super Admin email (used by setup endpoint). Also serves as fallback.
SUPER_ADMIN_EMAIL=admin@hospital.com
# Secret for creating additional Super Admins after initial setup.
# Generate: openssl rand -hex 32
ADMIN_SETUP_SECRET=

# ---- Database ---------------------------------------------------------------
DATABASE_PATH=./data/clinic.db

# =============================================================================
# GOOGLE WORKSPACE INTEGRATION (Calendar + Sheets + Drive)
# Create a service account in Google Cloud, enable Calendar, Sheets & Drive APIs,
# share the calendar and spreadsheet with the service account email,
# then paste the JSON key below (single line) or set the path.
# See docs/GOOGLE_SETUP.md for full instructions.
# =============================================================================
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEETS_SPREADSHEET_ID=

# ---- Google OAuth (Sign-In) -------------------------------------------------
# Create OAuth 2.0 credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
# See docs/GOOGLE_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- Google Drive (Gallery & Document Storage) ------------------------------
# Uses same GOOGLE_SERVICE_ACCOUNT_JSON with Drive scope.
# Folder structure is created automatically via /api/admin/drive.
# See docs/GOOGLE_DRIVE_SETUP.md

# =============================================================================
# NOTIFICATIONS
# Email: any SMTP server (Gmail SMTP, SendGrid, Postmark, etc.)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=clinic@example.com
SMTP_FROM_NAME=City Care Hospital
# SMS: Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# =============================================================================
# PAYMENT GATEWAY — Razorpay (India)
# Create account at https://razorpay.com — get keys from Dashboard → Settings → API Keys
# See docs/PAYMENT_SETUP.md
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# =============================================================================
# ONLINE CONSULTATION PLATFORM
# Supported: google_meet | jitsi | zoom | custom
# =============================================================================
CONSULTATION_PLATFORM=google_meet
ZOOM_API_KEY=
ZOOM_API_SECRET=
CUSTOM_MEETING_URL_TEMPLATE=

# =============================================================================
# AI RECEPTIONIST / AVATAR PROVIDER
# Options: local (built-in browser demo avatar, no keys) | heygen | did
# =============================================================================
AVATAR_PROVIDER=local
HEYGEN_API_KEY=
DID_API_KEY=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ONLINE_CONSULTATIONS_ENABLED=true
SMS_NOTIFICATIONS_ENABLED=false
